{
  "name": "@nba/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "browsers:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@nba/shared": "*",
    "axe-core": "^4.14.0",
    "bullmq": "^5.34.0",
    "cheerio": "^1.0.0",
    "chrome-launcher": "^1.2.2",
    "ioredis": "^5.4.1",
    "lighthouse": "^13.6.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.49.0",
    "pngjs": "^7.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
