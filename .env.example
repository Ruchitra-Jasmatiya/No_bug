# =============================================================================
# NO BUGS ALLOWED — environment variables
# Copy to .env for local development. NEVER commit .env. Real values belong in
# your hosting provider's secret store (Railway / Render / Vercel).
# Only variables used by the current build are listed here.
# =============================================================================

# ---- Database (Supabase PostgreSQL) ----------------------------------------
# Supabase dashboard → Project Settings → Database → Connection string (use the
# "Session pooler" URI for long-lived servers). Server-side only.
SUPABASE_DB_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# ---- Queue (Redis / Upstash) ------------------------------------------------
# Upstash: use the "rediss://" TLS URL. Local Docker Compose: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ---- Auth (Supabase Auth) ---------------------------------------------------
# Project Settings -> API. The service-role key is a SECRET: server-side only, never in a VITE_ variable.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Legacy HS256 JWT secret. Only needed if your project still uses it; otherwise tokens are verified via JWKS.
# SUPABASE_JWT_SECRET=
# 32+ random characters; keys the one-time-code hashes. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ---- Email (Resend) — required in production: sign-up needs an emailed OTP --
RESEND_API_KEY=
# A sender on a domain you have verified in Resend, e.g. "NO BUGS ALLOWED <no-reply@yourdomain.com>"
EMAIL_FROM=

# ---- Local development WITHOUT a Supabase project -----------------------------
# AUTH_PROVIDER=local uses a built-in dev identity store (apply supabase/local/*.sql via `npm run db:migrate:local`).
# Needs SUPABASE_JWT_SECRET (any 32+ chars). The API REFUSES to start with this in production.
# AUTH_PROVIDER=local

# ---- API --------------------------------------------------------------------
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
# Comma-separated list of browser origins allowed to call the API (your Vercel domain in production).
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the API (Railway/Render = 1) so rate limits see real client IPs.
TRUST_PROXY=0

# ---- Worker -----------------------------------------------------------------
WORKER_CONCURRENCY=2
# Optional /healthz port (Render and some other platforms require one).
# PORT is shared with the API variable above; set it per service in production.
# Use a system Chrome/Chromium instead of Playwright's bundled one:
# CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome
# Containers are the sandbox boundary; Chromium's own sandbox needs extra kernel permissions there.
# CHROMIUM_NO_SANDBOX=true
# Recovery tuning (defaults are production-safe):
# HEARTBEAT_INTERVAL_MS=5000
# STALE_AFTER_MS=30000
# REAPER_INTERVAL_MS=15000
# LOCK_DURATION_MS=30000

# ---- DEVELOPMENT / TESTS ONLY ------------------------------------------------
# Allows testing sites on localhost / private IPs. The cloud-metadata endpoint stays blocked.
# The process REFUSES TO START if this is true while NODE_ENV=production.
# NBA_ALLOW_PRIVATE_TARGETS=false

# ---- Security alerts ---------------------------------------------------------
# Who receives "too many failed logins" alerts (more than 10 in 15 minutes). Never hardcoded in the code.
# Without it, alerts are still recorded in the admin dashboard; no email is sent.
ADMIN_NOTIFICATION_EMAIL=

# ---- AI (BUGSY explanations + chat). Optional: without a key the product works and says AI is off. ----
# AI_PROVIDER=anthropic              # anthropic | openai | openai-compatible
# AI_API_KEY=                        # (or ANTHROPIC_API_KEY for anthropic). SECRET, server-side only.
# AI_MODEL=claude-sonnet-5-5         # required for openai / openai-compatible
# AI_BASE_URL=                       # openai-compatible only, e.g. https://openrouter.ai/api/v1
# AI_TIMEOUT_MS=60000

# ---- Web (Vercel). VITE_ variables are PUBLIC: never put a secret here. ------------
# Leave empty when the site proxies /api (see web/vercel.json rewrites). Set only if the API is on another origin.
# VITE_API_BASE=
